# ============================================================================
# X4 Cloud Terminal — Example Environment Configuration
# Copy to `.env` for local runs, or paste into Render / Northflank Env Vars.
# NEVER commit your real `.env` file!
# ============================================================================

# Server Binding (Render sets PORT automatically)
HOST=0.0.0.0
PORT=8501

# Data Directory (SQLite ledger + encrypted vault)
X4_DATA_DIR=./data

# Broker Adapter: paper | mt5_bridge | metaapi
# Start with `paper` (100% standalone) or `mt5_bridge` (connects to MT5 EA / Wine Docker)
X4_BROKER_MODE=paper

# Policy File (SHA-256 verified on boot)
X4_POLICY_PATH=./policies/demo_default.yaml

# Operator UI & API Token (CHANGE THIS before exposing on the internet!)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
X4_API_TOKEN=change-me-generate-a-32-byte-random-token

# HMAC-SHA256 Shared Secret for MQL5 Cloud Bridge EA / Wine Relay
# Must match InpBridgeSecret inside mql5/X4_CloudBridge_EA.mq5
X4_BRIDGE_SECRET=change-me-generate-a-different-32-byte-secret

# Optional Master Passphrase for Cross-Platform AES-256-GCM Secret Vault
X4_VAULT_PASSPHRASE=

# Strategy Engine Settings
X4_DEFAULT_STRATEGY=keltner_atr_breakout
X4_SYMBOLS=XAUUSD,EURUSD,GBPUSD,USDJPY
X4_POLL_INTERVAL_SEC=5.0
X4_AUTO_START_ENGINE=false

# Fail-Closed Real Account Lock (ALWAYS keep false unless explicitly verified on Demo first!)
REAL_EXECUTION_UNLOCK=false

# Optional: MetaApi Cloud MT5 Adapter (only when X4_BROKER_MODE=metaapi)
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=
METAAPI_REGION=vint-hill

# Optional: Alert Webhook (Discord / Telegram / Slack / Generic JSON POST)
X4_ALERT_WEBHOOK_URL=
