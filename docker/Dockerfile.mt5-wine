# Linux + Wine + MetaTrader 5 + noVNC Container
# Replaces a paid Windows Server VM on any Linux host, WSL2, or old laptop (zero Windows license, zero .edu email).
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    WINEPREFIX=/mt5/.wine \
    WINEARCH=win64 \
    DISPLAY=:99 \
    VNC_PORT=5900 \
    NOVNC_PORT=6080

RUN dpkg --add-architecture i386 \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg2 \
        wget \
        xvfb \
        fluxbox \
        x11vnc \
        novnc \
        websockify \
        winbind \
        cabextract \
        fonts-liberation \
    && mkdir -pm755 /etc/apt/keyrings \
    && wget -qO /etc/apt/keyrings/winehq-archive.key https://dl.winehq.org/wine-builds/winehq.key \
    && wget -qNP /etc/apt/sources.list.d/ https://dl.winehq.org/wine-builds/ubuntu/dists/jammy/winehq-jammy.sources \
    && apt-get update \
    && apt-get install -y --install-recommends winehq-stable \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /mt5/installers /mt5/experts /mt5/.wine
WORKDIR /mt5

# Stage X4 Cloud Bridge EA inside the container so it can be copied directly into MQL5/Experts
COPY mql5/X4_CloudBridge_EA.mq5 /mt5/experts/X4_CloudBridge_EA.mq5
COPY docker/start-mt5-wine.sh /mt5/start-mt5-wine.sh
RUN chmod +x /mt5/start-mt5-wine.sh

EXPOSE 6080

CMD ["/mt5/start-mt5-wine.sh"]
